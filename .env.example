MOCK_MODE=true
ARDUBUDDY_BASE_URL=http://192.168.1.100
ARDUBUDDY_TIMEOUT=5
# Opsional; firmware ArduBuddy v1.0 mengabaikan header ini. Jangan anggap sebagai autentikasi.
ARDUBUDDY_TOKEN=
VERIFY_AFTER_WRITE=true
ALLOW_STRAPPING_PINS=false
# Firmware v1.0 has no HTTP auth; keep the ESP32 address on a private LAN.
# Only set true if you deliberately control the whole network path.
ALLOW_PUBLIC_BASE_URL=false
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
DEVICE_ID=office-main
LOG_LEVEL=INFO
# Untuk pengujian: pindahkan lokasi config.json dan log connector.
# ARDUBUDDY_CONFIG_DIR=C:/Temp/ardubuddy-config
